<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest><AssemblyName>OneTunnel</AssemblyName>
	<Version>0.1.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;dist\**;assets\downloads\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup><Compile Remove="Core\**;Service\**;GoCore\**;Presentation\**;Client\obj\**;Client\bin\**"/><ProjectReference Include="Presentation\OneTunnel.Presentation.csproj"/></ItemGroup>
  <Target Name="BuildGoProfileHost" BeforeTargets="PrepareForBuild"><Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\Build-ProfileHost.ps1&quot;"/></Target>
  <ItemGroup><Content Include="OneTunnel.Profiles.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="engines\LICENSE*.txt;engines\provenance.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="assets\emoji\*.png;assets\LICENSE.twemoji.txt;assets\LICENSE.uniseg.txt;assets\emoji-provenance.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
