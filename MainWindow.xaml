<Window x:Class="OneTunnel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:OneTunnel.Controls" Title="OneTunnel — подключения" Width="1240" Height="850" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid Background="{StaticResource Canvas}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <Grid Margin="16,24,14,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="OneTunnel" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Подключения на этом компьютере" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,24" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="1">
     <Button x:Name="HomeNavigationButton" Content="Подключения" HorizontalContentAlignment="Left" Click="Home_Click"/>
     <Button x:Name="AddProfileButton" Content="Добавить профиль" HorizontalContentAlignment="Left" Click="Add_Click"/>
     <Button x:Name="SubscriptionButton" Content="Подписки" HorizontalContentAlignment="Left" Click="Subscriptions_Click"/>
     <Button x:Name="GroupsNavigationButton" Content="Группы" HorizontalContentAlignment="Left" Click="Groups_Click"/>
     <Button x:Name="EventsNavigationButton" Content="События" HorizontalContentAlignment="Left" Click="Events_Click"/>
    </StackPanel>
    <StackPanel Grid.Row="2"><TextBlock Text="Windows x64" Foreground="{StaticResource Muted}" FontSize="12" Margin="4,0,0,8"/><Button Content="Движки и восстановление" HorizontalContentAlignment="Left" Click="Engines_Click"/><CheckBox x:Name="TrayNotificationsBox" IsEnabled="False" Margin="4,8,4,12" Checked="TrayNotifications_Changed" Unchecked="TrayNotifications_Changed" ToolTip="Уведомления включаются только на время работы приложения."><TextBlock Text="Уведомлять об изменении статуса" TextWrapping="Wrap" MaxWidth="130" FontSize="12"/></CheckBox><Button x:Name="HideToTrayButton" Content="Свернуть в трей" IsEnabled="False" HorizontalContentAlignment="Left" ToolTip="Скрывает окно. Нажми Ctrl+Shift+O, чтобы вернуть его." Click="HideToTray_Click"/><TextBlock Text="Вернуть: Ctrl+Shift+O" Foreground="{StaticResource Muted}" FontSize="12" Margin="4,0,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,22,28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock x:Name="PageTitle" Text="Подключения" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Text="Профили, сохранённые на этом компьютере" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" x:Name="ImportConnectionButton" Content="Импортировать подключение" Background="{StaticResource Accent}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Subscription_Click"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <Grid x:Name="ConnectionPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <StackPanel><ui:EmojiText x:Name="ProfileTitle" Value="Добавь первое подключение" FontSize="22" FontWeight="SemiBold" Margin="0,0,12,4"/><Border Background="{StaticResource StatusSurface}" CornerRadius="4" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,10"><TextBlock x:Name="StatusLabel" Text="Отключено" FontSize="12" MaxWidth="300"/></Border></StackPanel>
         <TextBlock x:Name="ProfileDescription" Text="Импортируй конфигурацию или подписку. Профили хранятся на этом компьютере." Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
         <StackPanel x:Name="ModePanel" Visibility="Collapsed"><TextBlock Text="Куда направлять трафик" FontWeight="SemiBold" Margin="0,0,0,6"/><ComboBox x:Name="ModeBox" SelectedIndex="0" MaxWidth="450" HorizontalAlignment="Left" MinWidth="340" SelectionChanged="Mode_Changed"><ComboBoxItem Content="Локальный прокси · только выбранные приложения"/><ComboBoxItem Content="Всё устройство · системный туннель"/></ComboBox><TextBlock x:Name="ModeHelp" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Background="{StaticResource InfoSurface}" CornerRadius="6" Padding="13" Margin="18,0,0,0" MaxWidth="255"><StackPanel><TextBlock x:Name="ConnectionInfo" Text="AmneziaWG · WireGuard · VLESS · SOCKS5 · Hysteria2 · Shadowsocks" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionHint" Text="Серверы не входят в приложение. Используй собственную конфигурацию или данные своего провайдера." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
       </Grid>
      </Border>
      <WrapPanel Grid.Row="1" Margin="0,0,0,13"><Button x:Name="ConnectButton" Content="Подключить" Background="{StaticResource Accent}" Foreground="White" IsEnabled="False" Click="Connect_Click"/><Button x:Name="CancelGroupButton" Visibility="Collapsed" Content="Отменить проверку" IsEnabled="False" Click="CancelGroup_Click"/><Button x:Name="CheckGroupButton" Content="Проверить группу" IsEnabled="False" Click="CheckGroup_Click"/><Button x:Name="ProbeButton" Content="Проверить доступ" IsEnabled="False" Click="Probe_Click"/><Button x:Name="EditButton" Content="Изменить" IsEnabled="False" Click="Edit_Click"/><Button x:Name="DeleteButton" Content="Удалить" IsEnabled="False" Click="Delete_Click"/></WrapPanel>
      <StackPanel Grid.Row="2" Margin="0,0,0,12"><WrapPanel VerticalAlignment="Center"><CheckBox x:Name="FavoritesOnlyBox" Content="Только избранное" VerticalAlignment="Center" Margin="4,4,14,4" Checked="LibraryFilter_Changed" Unchecked="LibraryFilter_Changed"/><ComboBox x:Name="LibrarySortBox" Width="178" SelectedIndex="0" SelectionChanged="LibrarySort_Changed" ToolTip="Порядок профилей"><ComboBoxItem Content="Порядок хранения" Tag="stored"/><ComboBoxItem Content="По названию" Tag="name"/><ComboBoxItem Content="По протоколу" Tag="protocol"/></ComboBox><Button x:Name="FavoriteButton" Content="Добавить в избранное" IsEnabled="False" Click="Favorite_Click"/><TextBlock x:Name="LibraryStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,4,4,4"/></WrapPanel><Grid Margin="0,8,0,0"><TextBox x:Name="SearchBox" MinHeight="40" ToolTip="Поиск по названию, группе и протоколу" TextChanged="Search_Changed"/><TextBlock IsHitTestVisible="False" Text="Поиск по профилю, группе или протоколу" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></StackPanel>
      <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="2,0,2,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Профили" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ProfileCount" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel><WrapPanel Grid.Column="1"><Button x:Name="ExpandAllGroupsButton" Content="Развернуть группы" Padding="8,4" Margin="2" Click="ExpandAllGroups_Click"/><Button x:Name="CollapseAllGroupsButton" Content="Свернуть группы" Padding="8,4" Margin="2" Click="CollapseAllGroups_Click"/></WrapPanel></Grid>
       <Grid Grid.Row="1"><ListBox x:Name="ProfilesList" SelectionChanged="Profiles_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" MinHeight="140" MaxHeight="430" IsTabStop="True">
        <ListBox.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="True" Loaded="Group_Loaded" Expanded="Group_Changed" Collapsed="Group_Changed" Margin="0,4,0,8"><Expander.Header><StackPanel Orientation="Horizontal"><ui:EmojiText Value="{Binding Name}" FontWeight="SemiBold" MaxWidth="560" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ItemCount, StringFormat=({0})}" Margin="8,0,0,0" Foreground="{StaticResource Muted}"/></StackPanel></Expander.Header><ItemsPresenter/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ListBox.GroupStyle>
        <ListBox.ItemTemplate><DataTemplate><Grid Margin="3,2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ui:EmojiText Value="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" VerticalAlignment="Center" Margin="12,0,12,0"/><TextBlock Grid.Column="1" Text="{Binding Protocol}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Protocol}" VerticalAlignment="Center" Margin="8,0,10,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox><TextBlock Grid.Row="1" x:Name="EmptyProfilesHint" Text="Профили не найдены. Очисти поиск или импортируй подключение." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="22" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
      </Grid>
      <Expander x:Name="NetworkPreferencesPanel" Grid.Row="5" Header="DNS и правила маршрутизации" IsExpanded="False" Margin="0,0,0,12"><StackPanel Margin="0,10,0,0"><TextBlock Text="Настройки применяются к прокси-протоколам в режиме «Всё устройство». AWG/WireGuard и локальный прокси используют собственные настройки. Для применения пользовательских DNS и правил вручную установи обновлённую службу из нового комплекта OneTunnel; установленная служба не меняется автоматически." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><TextBlock Text="Пользовательские правила задают исключения из маршрутизации всего трафика через VPN. Правило direct отправляет совпавший трафик напрямую в сеть и может раскрыть его внешний адрес. Правила проверяются сверху вниз, первое совпадение важнее. Имена доменов не всегда видны при шифровании DNS/ECH, а процессы зависят от атрибуции Windows." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="DNS" Margin="0,0,0,4"/><ComboBox x:Name="NetworkDNSModeBox" SelectedIndex="0" SelectionChanged="NetworkDNSMode_Changed"><ComboBoxItem Content="По умолчанию" Tag="default"/><ComboBoxItem Content="DNS over HTTPS" Tag="https"/><ComboBoxItem Content="DNS over TLS" Tag="tls"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="IP DNS-сервера" Margin="0,0,0,4"/><TextBox x:Name="NetworkServerIPBox" ToolTip="Литеральный IPv4 или IPv6-адрес; DNS-запросы идут через прокси. Начальное соединение с внешним DNS использует фиксированный зашифрованный HTTPS bootstrap инфраструктуры; этот пользовательский резолвер его не заменяет."/></StackPanel></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Имя TLS-сервера" Margin="0,0,0,4"/><TextBox x:Name="NetworkServerNameBox"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="Порт (пусто — по умолчанию)" TextWrapping="Wrap" Margin="0,0,0,4"/><TextBox x:Name="NetworkPortBox"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Путь DoH (только HTTPS)" Margin="0,0,0,4"/><TextBox x:Name="NetworkPathBox"/></StackPanel></Grid><TextBlock Text="Правила: тип | действие | значение. Примеры: domain | proxy | login.example; domain-suffix | direct | example.org; cidr | reject | 192.0.2.0/24; process | proxy | C:\Apps\Browser\browser.exe. Типы: domain, domain-suffix, cidr, process. Действия: proxy, direct, reject. Максимум 64 правила; порядок строк сохраняется." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,5"/><TextBox x:Name="NetworkRulesBox" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="110" MaxHeight="220" FontFamily="Consolas"/><WrapPanel Margin="0,8,0,0"><Button x:Name="SaveNetworkPreferencesButton" Content="Сохранить DNS и правила" Background="{StaticResource Accent}" Foreground="White" IsEnabled="False" Click="SaveNetworkPreferences_Click"/><Button x:Name="ReloadNetworkPreferencesButton" Content="Обновить сведения" IsEnabled="False" Click="ReloadNetworkPreferences_Click"/><TextBlock x:Name="NetworkPreferencesStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,4,4,4"/></WrapPanel></StackPanel></Expander>      <Expander x:Name="ProfileOrganizationPanel" Grid.Row="4" Header="Копировать или переместить профиль" IsExpanded="False" Margin="0,0,0,12"><StackPanel Margin="0,10,0,0"><TextBlock Text="Копия не подключается автоматически. Управляемые подпиской профили можно копировать, но перемещать можно только между ручными группами. Перемещение сохраняет место профиля в порядке хранения и резервного подключения." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Название копии" Margin="0,0,0,4"/><TextBox x:Name="ProfileOrganizationNameBox"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Целевая группа" Margin="0,0,0,4"/><ComboBox x:Name="ProfileOrganizationGroupBox" IsEditable="True" IsTextSearchEnabled="True"/></StackPanel></Grid><WrapPanel Margin="0,8,0,0"><Button x:Name="DuplicateProfileButton" Content="Создать копию" IsEnabled="False" Background="{StaticResource Accent}" Foreground="White" Click="DuplicateProfile_Click"/><Button x:Name="MoveProfileButton" Content="Переместить" IsEnabled="False" Click="MoveProfile_Click"/><Button x:Name="ReloadProfileOrganizationButton" Content="Обновить сведения" IsEnabled="False" Click="ReloadProfileOrganization_Click"/><TextBlock x:Name="ProfileOrganizationStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,4,4,4"/></WrapPanel></StackPanel></Expander>
      <Expander x:Name="GroupResultsPanel" Grid.Row="6" Header="Результаты проверки группы" Visibility="Collapsed" Margin="0,0,0,16"><StackPanel Margin="0,12,0,0"><TextBlock Text="Время включает запуск движка, HTTPS-проверку и очистку. Это не ping и не скорость загрузки. WG/AWG и профили с пользовательскими DNS или правилами маршрутизации показывают только результат проверки конфигурации и не участвуют в выборе лучшего результата." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><WrapPanel Margin="0,0,0,8"><ComboBox x:Name="GroupResultSortBox" Width="178" SelectedIndex="0" SelectionChanged="GroupResultOptions_Changed" ToolTip="Порядок результатов"><ComboBoxItem Content="Порядок профилей" Tag="stored"/><ComboBoxItem Content="По времени проверки" Tag="duration"/></ComboBox><ComboBox x:Name="GroupResultFilterBox" Width="160" SelectedIndex="0" SelectionChanged="GroupResultOptions_Changed" ToolTip="Фильтр результатов"><ComboBoxItem Content="Все результаты" Tag="all"/><ComboBoxItem Content="Доступные" Tag="reachable"/><ComboBoxItem Content="С ошибкой" Tag="failed"/><ComboBoxItem Content="Только конфигурация" Tag="config-only"/></ComboBox><Button x:Name="SelectFastestResultButton" Content="Выбрать лучший результат" IsEnabled="False" Click="SelectFastestResult_Click" ToolTip="Выбирает лучший результат из всей проверки, независимо от текущего фильтра."/><Button x:Name="ClearGroupResultsButton" Content="Очистить результаты" IsEnabled="False" Click="ClearGroupResults_Click"/></WrapPanel><TextBlock x:Name="GroupResultsInfo" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="GroupResults"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><ui:EmojiText Value="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding TimingLabel}" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Expander>
     </Grid>
     <StackPanel x:Name="SubscriptionsPanel" Visibility="Collapsed">
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Сохранённые группы подписок" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ReloadSubscriptionsButton" Grid.Column="1" Content="Обновить список" Click="ReloadSubscriptions_Click"/><Button x:Name="ImportSubscriptionButton" Grid.Column="2" Content="Импортировать подписку" Click="Subscription_Click"/></Grid>
      <TextBlock Text="Данные об использовании и сроке действия сообщает провайдер. Они могут отсутствовать." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <ListBox x:Name="SubscriptionGroupsList" SelectionChanged="SubscriptionGroups_SelectionChanged" MaxHeight="250" MinHeight="76" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><ui:EmojiText Value="{Binding Group}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ProfileCount, StringFormat={}{0} проф.}" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding UpdatedAt}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="220" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="SubscriptionEmptyHint" Text="Сохранённых подписок пока нет. Импортируй подписку, чтобы добавить группу." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="10,10,10,18" Visibility="Collapsed"/>
      <Border x:Name="SubscriptionDetails" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,16" Visibility="Collapsed">
       <StackPanel><TextBlock x:Name="SubscriptionGroupTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SubscriptionProfileCount" Foreground="{StaticResource Muted}" Margin="0,4,0,14"/>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Использование" FontWeight="SemiBold"/><TextBlock x:Name="SubscriptionUsage" Grid.Column="1" Text="Не сообщается" TextWrapping="Wrap" Margin="8,0,18,0"/><TextBlock Text="Срок" Grid.Column="2" FontWeight="SemiBold"/><TextBlock x:Name="SubscriptionExpiry" Grid.Column="3" Text="Не сообщается" TextWrapping="Wrap" Margin="8,0,0,0"/></Grid>
        <TextBlock x:Name="SubscriptionUpdatedAt" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
        <WrapPanel><Button x:Name="CancelSubscriptionDownloadButton" Content="Отменить загрузку" Click="CancelSubscriptionDownload_Click" Visibility="Collapsed"/><Button x:Name="RefreshSubscriptionButton" Content="Проверить обновления" Background="{StaticResource Accent}" Foreground="White" Click="RefreshSubscription_Click"/><TextBlock x:Name="SubscriptionRefreshUnavailable" Text="Обновление сейчас недоступно" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"/></WrapPanel>
               <Border Background="{StaticResource InfoSurface}" CornerRadius="6" Padding="12" Margin="0,14,0,0"><StackPanel><TextBlock Text="Расписание проверки обновлений" FontWeight="SemiBold"/><TextBlock Text="Работает, пока окно OneTunnel открыто. По расписанию создаётся только предпросмотр; профили не применяются автоматически." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,4,0,8"/><WrapPanel><CheckBox x:Name="ScheduleEnabledBox" Content="Включить расписание" VerticalAlignment="Center" Margin="4,4,12,4"/><TextBlock Text="Интервал, минут" VerticalAlignment="Center" Margin="4,0,6,0"/><TextBox x:Name="ScheduleIntervalBox" Width="100"/></WrapPanel><WrapPanel Margin="0,8,0,0"><Button x:Name="SaveSubscriptionScheduleButton" Content="Сохранить расписание" IsEnabled="False" Click="SaveSubscriptionSchedule_Click"/><TextBlock x:Name="ScheduleStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,4,4,4"/></WrapPanel></StackPanel></Border></StackPanel>
      </Border>
      <Border x:Name="SubscriptionPreviewPanel" Background="{StaticResource InfoSurface}" CornerRadius="6" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
       <StackPanel><TextBlock Text="Предпросмотр изменений" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SubscriptionPreviewInfo" TextWrapping="Wrap" Margin="0,6,0,10"/><TextBlock x:Name="SubscriptionPreviewMetadata" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/><ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="SubscriptionChangesList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Kind}" FontWeight="SemiBold" Margin="0,0,12,0"/><ui:EmojiText Grid.Column="1" Value="{Binding Name}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding Protocol}" Foreground="{StaticResource Muted}" Margin="12,0,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><WrapPanel Margin="0,14,0,0"><Button x:Name="ApplySubscriptionButton" Content="Применить изменения" Background="{StaticResource Accent}" Foreground="White" Click="ApplySubscription_Click"/><Button x:Name="CancelSubscriptionPreviewButton" Content="Отменить" Click="CancelSubscriptionPreview_Click"/><TextBlock x:Name="SubscriptionApplyUnavailable" Text="Предпросмотр нельзя применить сейчас" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"/></WrapPanel></StackPanel>
      </Border>
     </StackPanel>
     <StackPanel x:Name="EditorPanel" Visibility="Collapsed">
      <TextBlock x:Name="EditorTitle" Text="Новое подключение" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <Grid Margin="0,0,0,6"><TextBlock Text="Название" VerticalAlignment="Center"/><Button x:Name="EmojiPickerButton" Content="Эмодзи и флаги" HorizontalAlignment="Right" Padding="10,5" Margin="0" Click="EmojiPicker_Click"/></Grid><TextBox x:Name="NameBox" MaxLength="4096" Margin="0,0,0,6" FontFamily="Segoe UI, Segoe UI Emoji, Segoe UI Symbol"/><ui:EmojiText x:Name="NamePreview" Value="{Binding Text, ElementName=NameBox}" FontSize="16" MinHeight="20" Margin="0,0,0,12"/>
      <TextBlock Text="Группа (для подписки — название группы)" Margin="0,0,0,6"/><ComboBox x:Name="GroupBox" IsEditable="True" Margin="0,0,0,14"/>
      <TextBlock x:Name="DetectedProtocol" Text="Протокол определится по конфигурации" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/><ComboBox x:Name="ProtocolBox" Visibility="Collapsed"/>
      <TextBlock Text="Конфигурация, ссылка подключения или HTTPS-подписка" Margin="0,0,0,6"/><TextBox x:Name="SourceBox" TextChanged="Source_Changed" AcceptsReturn="True" Height="185" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" SpellCheck.IsEnabled="False" MaxLength="4194304"/>
      <TextBlock Text="Здесь видны приватные ключи. Не отправляй скриншоты этого поля." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,14"/><WrapPanel Margin="0,0,0,14"><Button Content="Из файла" Click="Import_Click"/><Button Content="Вставить из буфера" Click="Paste_Click"/></WrapPanel>
      <Expander Header="Восстановление соединения" Margin="0,4,0,18"><StackPanel Margin="0,12,0,0"><CheckBox x:Name="AutoReconnectCheck" Content="Переподключаться при обрыве" Margin="0,0,0,12"/><CheckBox x:Name="FallbackCheck" Content="Использовать совместимые резервные серверы этой группы" IsEnabled="{Binding IsChecked, ElementName=AutoReconnectCheck}" Margin="0,0,0,10"/><TextBlock Text="До 9 попыток, до 8 резервных серверов в порядке списка. В режиме всего устройства kill switch сохраняется между попытками. Если восстановить связь не удалось, блокировка остаётся до явного отключения. После аварии службы требуется ручное восстановление." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel></Expander>
      <Expander x:Name="TransportExpander" Header="Фрагментация, шумы и MUX" Margin="0,4,0,18"><StackPanel Margin="0,14,0,0"><TextBlock Text="Настройки этого профиля сохраняются при обновлении подписки. По умолчанию выключены; применяются при следующем подключении." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/><CheckBox x:Name="FragmentCheck" Content="Фрагментация TLS" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="VLESS с TLS/REALITY поверх TCP. Делит приветствие TLS на части; может замедлить подключение." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><WrapPanel IsEnabled="{Binding IsChecked, ElementName=FragmentCheck}" Margin="0,0,0,18"><StackPanel Margin="0,0,20,0"><Label Content="Размер частей, байт" Target="{Binding ElementName=FragmentLengthBox}"/><TextBox x:Name="FragmentLengthBox" Text="100-200" Width="140" MaxLength="12"/></StackPanel><StackPanel><Label Content="Интервал, мс" Target="{Binding ElementName=FragmentIntervalBox}"/><TextBox x:Name="FragmentIntervalBox" Text="10-20" Width="140" MaxLength="12"/></StackPanel></WrapPanel><CheckBox x:Name="NoiseCheck" Content="Шумы UDP" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="Случайный пакет перед UDP-соединением: Hysteria2 или VLESS KCP/Hysteria. Сервер должен принимать такой трафик." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><WrapPanel IsEnabled="{Binding IsChecked, ElementName=NoiseCheck}" Margin="0,0,0,18"><StackPanel Margin="0,0,20,0"><Label Content="Размер пакета, байт" Target="{Binding ElementName=NoiseLengthBox}"/><TextBox x:Name="NoiseLengthBox" Text="50-150" Width="140" MaxLength="12"/></StackPanel><StackPanel><Label Content="Задержка, мс" Target="{Binding ElementName=NoiseDelayBox}"/><TextBox x:Name="NoiseDelayBox" Text="10-20" Width="140" MaxLength="12"/></StackPanel></WrapPanel><CheckBox x:Name="MuxCheck" Content="MUX · несколько потоков в одном соединении" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="VLESS TCP/WS/HTTPUpgrade без Vision, с поддержкой MUX на сервере. У XHTTP, gRPC и Hysteria объединение потоков встроено. WG, AWG, SOCKS5 и Shadowsocks эти настройки не используют." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><StackPanel IsEnabled="{Binding IsChecked, ElementName=MuxCheck}" HorizontalAlignment="Left"><Label Content="Одновременных потоков (1–128)" Target="{Binding ElementName=MuxConcurrencyBox}"/><TextBox x:Name="MuxConcurrencyBox" Text="8" Width="140" MaxLength="3" HorizontalAlignment="Left"/></StackPanel></StackPanel></Expander>
      <TextBlock Text="Подписка: импорт отдельных серверов без маршрутизации и балансировщиков Xray. Повторный импорт пропускает дубликаты; автопроверки обновлений нет." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/>
     </StackPanel>
     <StackPanel x:Name="EnginesPanel" Visibility="Collapsed"><TextBlock Text="Движки и восстановление" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock x:Name="EngineDetails" TextWrapping="Wrap" LineHeight="26" Margin="0,0,0,18"/>      <Border x:Name="BackupPanel" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,18"><StackPanel><TextBlock Text="Зашифрованная резервная копия" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Копия содержит библиотеку, настройки и источники подписок в зашифрованном файле. Пароль не сохраняется. Восстановление полностью заменит локальную библиотеку только после подтверждения." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,10"/><TextBlock Text="Пароль для экспорта" Margin="0,0,0,4"/><PasswordBox x:Name="BackupPasswordBox" MaxLength="1024"/><Button x:Name="ExportBackupButton" Content="Экспортировать резервную копию…" Background="{StaticResource Accent}" Foreground="White" HorizontalAlignment="Left" Click="ExportBackup_Click"/><Separator Margin="0,12,0,12"/><TextBlock Text="Пароль для восстановления" Margin="0,0,0,4"/><PasswordBox x:Name="RestorePasswordBox" MaxLength="1024"/><WrapPanel Margin="0,8,0,0"><Button x:Name="PreviewBackupButton" Content="Проверить резервную копию…" Click="PreviewBackup_Click"/><Button x:Name="CancelBackupPreviewButton" Content="Отменить проверку" IsEnabled="False" Click="CancelBackupPreview_Click"/><CheckBox x:Name="AddRestoreSchedulesBox" Content="Включить расписания из копии (при открытом окне OneTunnel)" IsChecked="False" Margin="4,8,4,4"/><Button x:Name="ApplyBackupRestoreButton" Content="Заменить локальную библиотеку…" IsEnabled="False" Background="{StaticResource Accent}" Foreground="White" Click="ApplyBackupRestore_Click"/></WrapPanel><TextBlock x:Name="BackupStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="Движки встроены в Go-ядро. Необходимые компоненты и лицензии входят в комплект приложения." Foreground="{StaticResource Muted}" Margin="0,0,0,18"/><Button x:Name="InstallServiceButton" Content="Установить / обновить службу" HorizontalAlignment="Left" Click="InstallService_Click" Margin="0,0,0,12"/><Button x:Name="StartServiceButton" Content="Запустить службу" HorizontalAlignment="Left" Click="StartService_Click" Margin="0,0,0,12"/><TextBlock Text="Служба управляет подключением. Закрытие окна сохраняет VPN; для возврата обычной сети нажми «Отключить». Установка требует подтверждения Windows один раз." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/><Button x:Name="LegacyRecoveryButton" Content="Восстановить подключение прежней версии от администратора" HorizontalAlignment="Left" Click="Elevate_Click" Margin="0,0,0,16"/><TextBlock Text="После аварийного завершения восстановление удалит только туннель OneTunnel и его временные настройки. Системный прокси Windows приложение не меняет." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/><WrapPanel Margin="0,0,0,24"><Button x:Name="RecoveryButton" Content="Очистить оставшееся подключение" Click="Recovery_Click"/><Button Content="Назад к подключению" Click="Cancel_Click"/></WrapPanel></StackPanel>
     <StackPanel x:Name="ActivityPanel" Visibility="Collapsed"><TextBlock Text="События" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Последние события приложения" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/><TextBox x:Name="EventLog" IsReadOnly="True" MinHeight="220" FontSize="12" Background="White" BorderBrush="{StaticResource Line}" Padding="12" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/><Border Background="{StaticResource InfoSurface}" CornerRadius="6" Padding="16" Margin="0,18,0,0"><StackPanel><TextBlock Text="Диагностический отчёт" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Содержит безопасное резюме комплекта и профилей. Не включает секреты и не проверяет подключение, утечки или kill switch." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/><WrapPanel><Button x:Name="GenerateDiagnosticsButton" Content="Сформировать отчёт" Background="{StaticResource Accent}" Foreground="White" Click="GenerateDiagnostics_Click"/><Button x:Name="CopyDiagnosticsButton" Content="Копировать" IsEnabled="False" Click="CopyDiagnostics_Click"/><Button x:Name="SaveDiagnosticsButton" Content="Сохранить…" IsEnabled="False" Click="SaveDiagnostics_Click"/></WrapPanel><TextBox x:Name="DiagnosticsReport" IsReadOnly="True" AcceptsReturn="True" Height="240" FontFamily="Consolas" FontSize="12" Background="White" BorderBrush="{StaticResource Line}" Padding="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/></StackPanel></Border></StackPanel>
     <StackPanel x:Name="GroupsPanel" Visibility="Collapsed"><TextBlock Text="Группы подключений" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Управление группами профилей и сохранённых подписок." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="Удаление группы подписки также удаляет локальный источник для обновления. Удалённые профили не импортируются автоматически." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/><WrapPanel Margin="0,0,0,8"><Button x:Name="ReloadGroupsButton" Content="Обновить список" Click="ReloadGroups_Click"/><TextBlock x:Name="GroupsStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,4,4,4"/></WrapPanel><ListBox x:Name="ConfigurationGroupsList" SelectionChanged="ConfigurationGroupsList_SelectionChanged" Background="Transparent" BorderThickness="0" MaxHeight="360" MinHeight="120" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><ui:EmojiText Value="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ProfileCount, StringFormat={}{0} проф.}" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="Подписка" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSubscription}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="GroupsEmptyHint" Text="Групп пока нет." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="16" Visibility="Collapsed"/><TextBlock Text="Название группы" FontWeight="SemiBold" Margin="0,14,0,6"/><TextBox x:Name="RenameGroupBox" IsEnabled="False"/><WrapPanel Margin="0,8,0,0"><Button x:Name="RenameGroupButton" Content="Переименовать" IsEnabled="False" Background="{StaticResource Accent}" Foreground="White" Click="RenameGroup_Click"/><Button x:Name="DeleteGroupButton" Content="Удалить группу" IsEnabled="False" Click="DeleteGroup_Click"/></WrapPanel></StackPanel>
    </Grid>
   </ScrollViewer>
   <WrapPanel x:Name="EditorActions" Grid.Row="2" Visibility="Collapsed" Margin="0,12,0,0"><Button x:Name="SaveProfileButton" Content="Сохранить / импортировать" Background="{StaticResource Accent}" Foreground="White" Click="Save_Click"/><Button Content="Отмена" Click="CancelEditor_Click"/></WrapPanel>
   <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,12,0,0"><TextBlock x:Name="Feedback" Text="Готов к настройке" Foreground="{StaticResource Muted}" FontSize="12" MaxHeight="66"/></Border>
  </Grid>
 </Grid>
</Window>
